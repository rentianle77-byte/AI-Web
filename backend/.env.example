# ===== 大模型(至少配一个;都不配则用 mock 演示模型,只能跑通流程不会“思考”)=====
# 可选:anthropic | openai | mock ;不填则自动:有 ANTHROPIC_API_KEY 用 anthropic,有 OPENAI_API_KEY 用 openai,否则 mock
LLM_PROVIDER=

# --- Claude(官方 SDK)---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 思考深度 low | medium | high (越高越贵越慢)
LLM_EFFORT=medium
# 走代理/中转时填,例如 https://your-proxy.example.com
ANTHROPIC_BASE_URL=

# --- OpenAI 兼容接口(LiteLLM / DeepSeek / 通义千问 / Kimi / 智谱 / OpenAI 都走这个)---
# LiteLLM 网关(推荐,一个 key 管所有模型):
#   OPENAI_API_KEY=sk-你的LiteLLM虚拟key
#   OPENAI_BASE_URL=http://你的litellm地址:4000/v1      # 注意结尾要带 /v1
#   OPENAI_MODEL=你在 LiteLLM config 里起的 model_name   # 例如 claude-opus-5 / deepseek-chat
#   LLM_PROVIDER=openai                                 # 显式指定,避免误判
# DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com            OPENAI_MODEL=deepseek-chat
# 通义千问:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   OPENAI_MODEL=qwen-plus
# Kimi:      OPENAI_BASE_URL=https://api.moonshot.cn/v1          OPENAI_MODEL=moonshot-v1-32k
# 智谱:      OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4 OPENAI_MODEL=glm-4-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ===== 数据库 =====
# MySQL(docker compose up -d 之后用这个)
DATABASE_URL=mysql+pymysql://express:express123@127.0.0.1:3307/express_agent?charset=utf8mb4
# 没有 MySQL 时可临时用 SQLite:
# DATABASE_URL=sqlite:///./data/app.db

# ===== 可选:向量检索(OpenAI 兼容 embeddings 接口;不配则只用 BM25 关键词检索)=====
# LiteLLM 也能代理 embeddings:EMBEDDING_BASE_URL=http://你的litellm地址:4000/v1
# 通义:EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ===== 可选:真实物流查询(快递100 企业版;不配则用演示物流数据)=====
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# ===== 其他 =====
# 主动跟进检查间隔(秒)
FOLLOWUP_CHECK_INTERVAL=10

# 跨域白名单。用 nginx 把前端和 /api 放同一域名时留空即可(推荐);
# 前后端分开部署才需要填,多个用逗号分隔:https://a.com,https://b.com
CORS_ORIGINS=
MAX_TOOL_ITERATIONS=12


# ===== 通知触达(让「主动跟进」真的找到用户,而不是等他打开网页)=====
# 三个通道都可选,配哪个用哪个,可以同时配。

# --- 邮件:零门槛,推荐先配这个 ---
# QQ 邮箱: SMTP_HOST=smtp.qq.com      SMTP_PORT=465  SMTP_SSL=true
# 163 邮箱: SMTP_HOST=smtp.163.com     SMTP_PORT=465  SMTP_SSL=true
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_SSL=false
# 注意:SMTP_PASSWORD 填的是「授权码」,不是邮箱登录密码。
#      QQ 邮箱在 设置→账户→POP3/SMTP服务 里开启并获取。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_FROM_NAME=快递管家

# --- 微信:Server 酱,个人开发者可用,不需要企业主体 ---
# 到 sct.ftqq.com 微信扫码登录即可拿到 key
SERVERCHAN_KEY=

# --- 通用 webhook:企业微信 / 飞书 / 钉钉机器人 ---
NOTIFY_WEBHOOK_URL=

# 默认收件人(界面里也能改,改了以界面为准)
NOTIFY_DEFAULT_CONTACT=

# 通知里附带的访问地址,例如 http://120.55.242.165
PUBLIC_BASE_URL=


# ===== 寄件真实下单(三条流程里唯一能端到端闭环的)=====
# 需要企业资质注册顺丰丰桥开放平台(qiao.sf-express.com),拿到顾客编码和校验码。
# 不配置时走演示下单:流程完整、能拿到运单号继续盯物流,
# 但运单号带 DEMO 前缀并明确标注,不会让人以为真下了单。
SF_PARTNER_ID=
SF_CHECKWORD=
SF_MONTHLY_CARD=
# 沙箱环境用 https://sfapi-sbox.sf-express.com,生产用默认值
SF_BASE_URL=https://bspgw.sf-express.com
